# GEMINI_API_KEY: Opsional — hanya untuk fitur AI enhancement (GEO citation check, semantic clustering, AI strategic insight).
# Aplikasi tetap berjalan penuh (crawling, on-page SEO, artikel inventory, EEAT, dll) tanpa key ini.
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PAGESPEED_API_KEY: Opsional tapi SANGAT DISARANKAN untuk produksi Vercel / serverless.
# Digunakan untuk audit Core Web Vitals (LCP, CLS, INP/FID, FCP) via Google PageSpeed Insights API v5.
# PENTING:
# 1. API key harus berasal dari Google Cloud Project yang telah meng-enable "PageSpeed Insights API"
#    (Link: https://console.cloud.google.com/apis/library/pagespeedonline.googleapis.com).
# 2. Application restriction di GCP Credentials harus "None" (karena request berasal dari server Node.js Vercel).
# 3. Masukkan di Vercel Dashboard -> Project Settings -> Environment Variables -> PAGESPEED_API_KEY, lalu REDEPLOY.
# Tanpa key ini, Vercel akan jatuh ke kuota publik Google PSI yang cepat habis/di-throttle pada shared IP serverless.
PAGESPEED_API_KEY="MY_PAGESPEED_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
